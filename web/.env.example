NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
# Server-only secret key for sending Auth invitations. Never expose as NEXT_PUBLIC_ or commit the real value.
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Subscription notification worker (server only)
SUBSCRIPTION_NOTIFICATION_DELIVERY_MODE=preview
RESEND_API_KEY=YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=no-reply@avenzoone.com
RESEND_WEBHOOK_SECRET=whsec_YOUR_RESEND_WEBHOOK_SIGNING_SECRET
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=CREATE_A_LONG_RANDOM_SECRET
# Stripe Test Mode only. Keep both values server-side and never prefix them with NEXT_PUBLIC_.
STRIPE_SECRET_KEY=sk_test_YOUR_STRIPE_TEST_SECRET_KEY
STRIPE_WEBHOOK_SECRET=whsec_YOUR_STRIPE_TEST_WEBHOOK_SECRET
# Safety switch. Phase 1.1.3.6 must remain disabled; enabling it does not by itself enable Live Mode.
STRIPE_LIVE_ACTIVATION=disabled
